# Smart function for sudo (that also understands sudo xargs)

unalias 2>/dev/null sudo
sudo() {
    local -a opts=()
    local -a setenv=()
    while (($#))
    do
        case $1 in
        (-[gpu])      opts=( "${opts[@]}" "$1" "$2" ) ; shift ;;  # common
        (-[CGMNm]-f*) opts=( "${opts[@]}" "$1" "$2" ) ; shift ;;  # for ~/sbin/run_as
        (-[CUp])      opts=( "${opts[@]}" "$1" "$2" ) ; shift ;;  # for /usr/bin/sudo
        (-*)          opts=( "${opts[@]}" "$1" ) ;;
        ([_a-zA-Z]*=*) [[ ${1%%=*} != *[^0-9a-zA-Z_]* ]] || break
            setenv=( "${setenv[@]}" "$1" )
            ;;
        (*) break ;;
        esac
        shift
    done

    case $1 in
    (xargs)
        shift
        while [[ $1 = [^-]*=* ]]
        do  setenv=( "${setenv[@]}" "$1" )
            shift
        done
        [[ $1 = -*r* ]] || {
            echo >&2 "Please use 'sudo xargs -r', or use 'sudo $( type -P xargs )' if you REALLY want the default behaviour"
            return 99
          # echo >&2 "# using shell alias 'sudo xargs -r ...'"
          # set -- -r "$@"
        }
        set xargs "$@"
        ;;
    (*)
        local _t
        _t=$( type -t "$1" ) &&
        case $_t in
        file | '' ) ;;
        * )
            if _p=$( type -p "$1" )
            then echo >&2 "# WARNING: 'sudo $1' won't run the shell $_t, it will run $p instead"
            else echo >&2 "# WARNING: 'sudo $1' won't run the shell $_t, and there doesn't seem to be an external command either"
            fi ;;
        esac
        ;;
    esac
    (( ${#setenv[@]} )) &&
        echo >&2 "# transposing ${#setenv[@]} environment settings from subcommand to sudo itself"
    ( export "${setenv[@]}" ; exec command $HOME/sbin/run_as -u0 -g0 "${opts[@]}" "$@" )
}
_provides sudo

complete -c sudo
