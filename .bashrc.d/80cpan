
cpan() {
    PATH=$HOME/perl5/bin:$PATH \
    PERL5LIB="/home/martin/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}" \
    PERL_LOCAL_LIB_ROOT="/home/martin/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}" \
    PERL_MB_OPT="--install_base \"/home/martin/perl5\"" \
    PERL_MM_OPT="INSTALL_BASE=/home/martin/perl5" \
    command cpan "$@"
}
