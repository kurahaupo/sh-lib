## HISTORY

# Don't put duplicate lines in the history, nor lines starting with whitespace.
# Append to history file rather than overwriting.

shopt -s histappend histreedit histverify
command_oriented_history=yes
HISTCONTROL=ignoreboth

# Only adjust history if LOGHOME is either unset, or the same as HOME

if [[ ${LOGHOME:-$HOME} = "$HOME" ]] ; then
    # Don't truncate unless it gets ludicrously huge.
    # Switch to new history file (.bash_history.d/$SECONDS.$TTY) AFTER setting
    # size etc.

    HISTSIZE=1000000
    HISTFILESIZE=1000000
    HISTTIMEFORMAT='%F,%T '

    _hist_dir=${LOGHOME:-$HOME}/.bash_history.d
    _hist_tmp=$HOME/tmp/hist.$$
    _hist_tty=${TTY=$( tty )}
    _hist_tty=${_hist_tty#/dev/}
    _hist_tty=${_hist_tty//\//-}
    _hist_tty=${_hist_tty:-None}
    _hist_host=${HOSTNAME%%.*}
    case $HOSTNAME in
        @(ds|erx)*.@(chermside|cs|cmsd).sig.*)          _hist_host=${HOSTNAME%%.*}-cs ;;
        @(ds|erx)*.@(mtwel|mw).sig.*)                   _hist_host=${HOSTNAME%%.*}-mw ;;
        @(ds|erx)*.@(orakei|ok|mb|mbay).sig.*)          _hist_host=${HOSTNAME%%.*}-ok ;;
        @(ds|erx)*.@(orewa|ow).sig.*)                   _hist_host=${HOSTNAME%%.*}-ow ;;
        @(ds|erx)*.@(stonefields|sf|kohi|int).sig.*)    _hist_host=${HOSTNAME%%.*}-sf ;;
        @(ds|erx).*.sig.*)                              _hist_host=${HOSTNAME%.sig.*} _hist_host=${_hist_host//./-} ;;
    esac

    HISTFILE=$_hist_dir/$SECONDS.$_hist_tty.$_hist_host

    [[ -d $_hist_dir ]] ||
    install -d -m1700 "$_hist_dir"

    # Save any current history to new HISTFILE, then clear all in-memory
    # history, and then read all history from the last 2 weeks back in.
    history -a

    # NOTE: « history -r /dev/stdin » fails if stdin is a pipe/fifo, so
    # write a temporary file.
    # Filenames are in timestamp order (at least, by starting time)
    if [[ $USER != root ]] ; then
        sudo chgrp -R "$USER" "$_hist_dir"/1*        2> /dev/null
        sudo chmod -R o=rw,g-wxs,o= "$_hist_dir"/1*  2> /dev/null
        sudo find "$_hist_dir" -maxdepth 1 -name '1*' -type f \( -user "$USER" \(   -perm /040 -exec chmod -c g-r {} + , -true \) \
                                                                            -o \( ! -perm /040 -exec chmod -c g+r {} +         \) \)
    fi
    _hist_stx=$'\x02'    # separates timestamp from its event (history files are manually edited from time to time to ensure this)
    find "$_hist_dir" -maxdepth 1 -name '1*' -type f -mtime -15 -print0 |
     sort -z |
      xargs -r0 cat |
       sed "/^#[[:digit:]]+$_hist_stx/ s/$_hist_stx/\n/g" > "$_hist_tmp" &&
    history -c &&
    history -r "$_hist_tmp" &&
    rm -f "$_hist_tmp"

    # Make sure we save the history as we go...
    PROMPT_COMMAND+=$'\n history -a'

    # Clear temp vars
    unset "${!_hist_@}"
fi
