
case ${HOSTKREL-$( uname -r )} in
  *UBNT)

    show() {
        case $* in
          'configuration commands'*)
            cli-shell-api showConfig --show-active-only --show-commands  "${@:3}" ;;
          configuration*)
            cli-shell-api showCfg --show-active-only --show-hide-secrets "${@:2}" ;;
          *)
            cli-shell-api showConfig "$@"
        esac
    }
    showcurr() { cli-shell-api showConfig --show-active-only "$@" ; }
    showdiff() { cli-shell-api showConfig --show-commands "$@" ; }
    sd() { cli-shell-api showCfg | grep '^[-+>]' ; }

    vv() { printf '\e[2m%s\e[m\n' "$*" >&2 ; "$@" ; }

    ii() {
        local what=$1 type=$2
        cli-shell-api -- showCfg interfaces "$type" |
        grep "^ $type" |
        cut -d' ' -f3 |
        while read int
        do
            vv "$what" interfaces "$type" "$int" "${@:3}"
            echo
        done
    }

    ie() { ii "$1" ethernet  "${@:2}" ; }
    is() { ii "$1" switch    "${@:2}" ; }
    iw() { ii "$1" wireguard "${@:2}" ; }

    ve() { ii show ethernet  "$@" ; }
    vs() { ii show switch    "$@" ; }
    vw() { ii show wireguard "$@" ; }

    ;;
esac

