	k	= stash save
	keep	= stash save
	save	= stash save

	man	= help

	s	= status
	st	= status
	stat	= status

	t	= tag

[log]
	date = iso

[merge]
	defaultToUpstream = true

[push]
	default = matching

[http]
	cookiefile = /home/martin/.gitcookies

[url "ssh://git@gist.github.com/"]
	# In case I copied with (my) username included (only works for my own
	# gists, but those are the only ones I can push anyway):
	pushInsteadOf = https://gist.github.com/kurahaupo/
	pushInsteadOf = http://gist.github.com/kurahaupo/
	# For gists cloned with official no-username URL:
	pushInsteadOf = https://gist.github.com/
	pushInsteadOf = http://gist.github.com/

# user identification -- one stanza per remote

[user]
	user	= martin
	name	= Martin D Kealey
	email	= martin@kurahaupo.gen.nz

[github]
	user	= kurahaupo
	token	= 3f5f6925f490629675ae91b4313c1ed4
	name	= Martin Kealey
	email	= from-github@kurahaupo.gen.nz

[user3]
	name	= Martin Kealey
	email	= from-github@kurahaupo.gen.nz

[user2]
	name	= Martin Kealey
	user	= martink
	email	= martin.kealey@smxemail.com

[user4]
	name	= Martin Kealey
	email	= martink@catalyst.net.nz

[locke]
