# vim: set ts=8 sw=8 noet nowrap :

# NOTE: some configuration is also in ~/.config/git/*

[alias]
	b	= branch -v
	ba	= branch -av
	baq	= branch -a
	bq	= branch
	bqa	= branch -a

# I would like "co" for "checkout", but that's a prefix of "commit" (checkin)
# so use "cho" instead.

	cho	= checkout
	chob	= checkout -b

# Warn sternly about "git co" because it's a prefix of "git commit", while NOT
# being an abbreviation for it.
# Suggest "gco" because it's shorter than both "git ci" and "git commit".
	co	= ! gitwarn --why=ambiguous     --suggest=checkout --trim=2 -- git co

#	checkin	= ! gitwarn --why=deprecated    --suggest=commit   --trim=2 -- git checkin
	checkin	= commit
	ca	= commit --amend
	cae	= commit --amend --edit
	can	= commit --amend --no-edit
	ci	= commit
	cie	= commit --edit
	cin	= commit --no-edit

	catfile	= ! gitwarn --why=typo --keep=1 --suggest=cat-file --trim=2 -- git catfile
#	cat	= cat-file
	cf	= cat-file

	che	= cherry-pick
	cherrypick = cherry-pick
#	cp	= cherry-pick

	d	= diff
	di	= diff
	dn	= diff --name-only
	dno	= diff --name-only

	et	= rebase --edit-todo
	ff	= pull --ff-only

	h1	= log -n1                --pretty=tformat:\"      \t%C(11)%h %C(13)%t %C(9)%ai %C(6)%aN%C(reset)   \t| %s%C(12)%d%C(reset)\" --graph
	h2	= log -n2   --topo-order --pretty=tformat:\"      \t%C(11)%h %C(13)%t %C(9)%ai %C(6)%aN%C(reset)   \t| %s%C(12)%d%C(reset)\" --graph
	h3	= log -n3   --topo-order --pretty=tformat:\"      \t%C(11)%h %C(13)%t %C(9)%ai %C(6)%aN%C(reset)   \t| %s%C(12)%d%C(reset)\" --graph
