[gitprivate]
	user	= martink

[safe]
	directory = /serve/hosts/quaker.org.nz/tui
	directory = /serve/hosts/quaker.org.nz/tuitools
	directory = /home/backup/ds920.kohi.sig.nz/volume2/sig/serve/exim
	directory = /home/martin/git/coreutils/coreutils-9.1

[patchid]
	stable = true

[remote]
	pushDefault = mine

[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential
[init]
	defaultBranch = main
