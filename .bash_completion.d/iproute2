        __ip_deferred
        return 0
    done    # }}} end singleton loop
    COMPREPLY=()
    __ip_debug_parsing_state X '***ABORT***'
    #__ip_warning "Lost sync? STATE=$STATE expect=$expecting cur=$__cur"

    [[ $COMP_TYPE = best ]] && COMP_TYPE=9

    __ip_deferred
    return 1
