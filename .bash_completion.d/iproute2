                    { __ip_match_final && break ; } ||
                    { __ip_match_failed && break 2 ; }
                    ;;

                (LABEL)
                    __ip_match ANY $save_device: ||
                    true
                    ;;

                (TABLE)
                    __ip_match NUM --bits=8 ||
                    __ip_match ANY default local main $( __ip_slurp /etc/iproute2/rt_tables ) ||
                    { (( __optional )) && __ip_pop_state && continue ; } ||
                    { __ip_match_final && break ; } ||
                    { __ip_match_failed && break 2 ; }
                    ;;

                (TABLE+)
                    __ip_match NUM --max=255 --min=-2 ||
                    __ip_match ANY all default local main $( __ip_slurp /etc/iproute2/rt_tables ) ||
                    { (( __optional )) && __ip_pop_state && continue ; } ||
                    { __ip_match_final && break ; } ||
                    { __ip_match_failed && break 2 ; }
                    ;;

                (RTYPE)
                    __ip_match ANY -R blackhole==RTYPE broadcast==RTYPE \
                                      local==RTYPE multicast==RTYPE \
                                      nat==RTYPE prohibit==RTYPE \
                                      throw==RTYPE unicast==RTYPE \
                                      unreachable==RTYPE ||
                    { (( __optional )) && __ip_pop_state && continue ; } ||
                    { __ip_match_final && break ; } ||
                    { __ip_match_failed && break 2 ; }
