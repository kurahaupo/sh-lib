#
# This is an improved version of _configured_interfaces from
# /etc/bash_completion + /usr/share/bash-completion/bash_completion that
# chooses the system type just once, not every time.
#
_configured_interfaces ()
{
    if [[ -f /etc/network/interfaces ]] ; then
        # Debian system (-f /etc/debian_version)
        _configured_interfaces ()
        {
            COMPREPLY=( $( sed -ne 's/^ *iface \+\([^ ]\+\).*$/\1/p' /etc/network/interfaces ) )
        }
    elif [[ -d /etc/sysconfig/network ]] ; then
        # SuSE system (-f /etc/SuSE-release)
        _configured_interfaces ()
        {
            COMPREPLY=( $( command ls /etc/sysconfig/network/ifcfg-* |
                           sed -ne 's|.*ifcfg-\('$cur'.*\)|\1|p' ) )
        }
    elif [[ -f /etc/sysconfig/interfaces ]] ; then
        # PLD Linux -f /etc/pld-release
        _configured_interfaces ()
        {
            COMPREPLY=( $( command ls -B /etc/sysconfig/interfaces |
                           sed -ne 's|.*ifcfg-\('$cur'.*\)|\1|p' ) )
        }
    elif [[ -d /etc/sysconfig/network-scripts ]] ; then
        # Red Hat
        _configured_interfaces ()
        {
            COMPREPLY=( $( command ls /etc/sysconfig/network-scripts/ifcfg-* |
                           sed -ne 's|.*ifcfg-\('$cur'.*\)|\1|p' ) )
        }
    elif type > /dev/null -P ip ; then
        # Actual live interfaces, as per iproute2
        _configured_interfaces ()
        {
            COMPREPLY=( $( ip -o link show | sed -e 's/^[0-9]*[: ]*//; s/[: ].*//;' ) )
        }
    elif type > /dev/null -P ifconfig ; then
        # Actual live interfaces, as per classic ifconfig
        _configured_interfaces ()
        {
            COMPREPLY=( $( ifconfig -a | sed -e 's/ .*//; /./! d;' ) )
        }
    elif [[ -d /sys/class/net && -r /sys/class/net ]]; then
        # Read directly from Linux /sys
        _configured_interfaces ()
        {
            COMPREPLY=( /sys/class/net/* )
            COMPREPLY=( "${COMPREPLY[@]##*/}" )
        }
    else
        _configured_interfaces ()
        {
            COMPREPLY=()
        }
    fi
    _configured_interfaces "$@"
}
