                        (*/*/*) false ;;
                        (*)     __ip_match NUM -I'*/' --bits=32 ;;
                    esac ||
                    { (( __optional )) && __ip_pop_state && continue ; } ||
                    { __ip_match_final && break ; } ||
                    { __ip_match_failed && break 2 ; }
                    ;;

